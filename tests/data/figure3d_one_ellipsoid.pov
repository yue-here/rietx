  #declare RIETX_FACE = finish { ambient RIETX_AMBIENT diffuse RIETX_FACE_DIFFUSE }
#end
#declare RIETX_INK = finish { ambient 0 emission 1 diffuse 0 }

background { color srgb <1, 1, 1> }

camera {
  orthographic
  location <1.41421356237, 2.1076033666, -21.1580987216>
  direction <0, 0, 1>
  right <12.4389601989, 0, 0>
  up <0, 11.8558839396, 0>
}

