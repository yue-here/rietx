#version 3.7;

#declare RIETX_RADIOSITY = off;   // on: global illumination
#declare RIETX_AMBIENT = 0.45;
#declare RIETX_DIFFUSE = 0.6;
#declare RIETX_PHONG = 0.16;
#declare RIETX_PHONG_SIZE = 40;
#declare RIETX_FACE_DIFFUSE = 0.55;
#declare RIETX_VIEW = transform { matrix <-0.707106781187, -0.315008486146, -0.633063704264, 0.707106781187, -0.315008486146, -0.633063704264, 0, 0.895287276416, -0.445489273371, 0, 0, 0> }

global_settings {
  assumed_gamma 1.0
  ambient_light rgb 1
  #if (RIETX_RADIOSITY)
    radiosity { pretrace_start 0.08 pretrace_end 0.01 count 150
                recursion_limit 2 nearest_count 10 error_bound 0.5 }
  #end
}
#if (RIETX_RADIOSITY)
  #declare RIETX_LIT = finish { ambient 0 emission 0 diffuse RIETX_DIFFUSE
