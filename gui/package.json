{
  "name": "rietx-gui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Frontend workspace for `rietx gui`. Never ships in the wheel — the build output under src/rietx/gui/static is committed, so installing rietx[gui] needs no node.",
  "scripts": {
    "dev": "vite",
    "build": "python3 scripts/vendor.py && vite build && python3 scripts/build_info.py",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.1.2",
    "jsdom": "^30.0.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.1.5",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.3",
    "svgcanvas": "2.6.0",
    "uplot": "1.6.32"
  }
}
