+def _merge_map(n_table, pb, groups):
+    """Sparse expansion E with θ_full = E·θ_merged: table identity, then one
+    column per overlap group (equal split of the group total) and one per
+    singleton."""
+    from scipy import sparse
+    rows, cols, vals = list(range(n_table)), list(range(n_table)), [1.0] * n_table
+    grouped = np.zeros(pb.n, dtype=bool)
+    j = n_table
+    for g in groups:
+        for k in g:
+            rows.append(n_table + k); cols.append(j); vals.append(1.0 / len(g))
+        grouped[g] = True
+        j += 1
+    for k in np.flatnonzero(~grouped):
+        rows.append(n_table + int(k)); cols.append(j); vals.append(1.0)
+        j += 1
+    return sparse.csr_matrix((vals, (rows, cols)), shape=(n_table + pb.n, j))
 
 
